# This repository tracks only the two RideFleet plugins inside the
# WordPress wp-content/plugins/ directory. Everything else is ignored.

# Ignore everything at the root by default…
/*

# …then explicitly allow the things we want to track.
!/.gitignore
!/README.md
!/ridefleet-ai-chatbot
!/ridefleet-booking

# Common artifacts inside the tracked plugin folders.
**/node_modules/
**/vendor/
**/.DS_Store
**/Thumbs.db
**/*.log
**/.idea/
**/.vscode/
**/.phpunit.result.cache
